    "obstetric": ["gestas", "partos", "cesareas", "abortos", "hijos_vivos", "antecedentes_infecciosos", "ivu", "cervicovaginitis", "trastorno_hipertensivo", "trastorno_metabolico", "otros_factores", "amenaza_aborto", "amenaza_parto_pretermino", "maduracion_pulmonar", "trabajo_parto", "via_nacimiento", "motivo_cesarea", "analgesia", "liquido_amniotico", "membranas"],
    "neonatal": ["sexo", "capurro_semanas", "apgar_1", "apgar_5", "silverman", "reanimacion", "oxigeno", "hipoxia_perinatal", "trauma_obstetrico", "peso_g", "talla_cm", "pc_cm", "pt_cm", "pa_cm", "si_cm", "pie_cm", "peso_para_edad", "hemotipo_rn", "diagnosticos_rn", "estado_salud", "destino_rn"],
